{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.3.0",
  "author": "Luka Havrlisan",
  "default_locale": "en",
  "icons": {
    "16": "icons/translate.svg",
    "32": "icons/translate.svg",
    "64": "icons/translate.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "translate-mail@luka-havrlisan",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "message_display_action": {
    "default_title": "__MSG_translate__",
    "default_icon": "icons/translate.svg"
  },
  "compose_action": {
    "default_title": "__MSG_translateReply__",
    "default_icon": "icons/translate.svg",
    "default_popup": "src/compose.html"
  },
  "commands": {
    "_execute_message_display_action": {
      "suggested_key": { "default": "Ctrl+Shift+X" },
      "description": "__MSG_translate__"
    }
  },
  "options_ui": {
    "page": "src/options.html"
  },
  "permissions": ["messagesRead", "scripting", "storage", "compose"],
  "host_permissions": [
    "https://translation.googleapis.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://translate.api.cloud.yandex.net/*"
  ]
}
